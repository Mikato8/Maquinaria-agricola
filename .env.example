APP_NAME="AgroMáquina MX"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://TU-SITIO.hostingersite.com
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es_MX
APP_KEY=

# Neon: en Hostinger usa el host DIRECTO y añade el endpoint en options,
# porque su libpq no envía SNI. Ejemplo:
# DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&options=endpoint%3Dep-xxxx"
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
DB_DRIVER=pdo

SESSION_NAME=agromaquina_session
SESSION_LIFETIME=7200
SESSION_SECURE=true

UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_FILES=4
UPLOAD_MAX_DOCUMENT_BYTES=12582912

MAIL_ENABLED=false
MAIL_FROM=no-reply@agromaquina.mx
MAIL_FROM_NAME="AgroMáquina MX"
AUTO_VERIFY_USERS=false
